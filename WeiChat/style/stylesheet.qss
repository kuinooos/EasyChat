* {
    font-family: "Inter", "Microsoft YaHei UI", sans-serif;
    font-size: 14px;
    color: #E6E8EB;
}

QMainWindow, QDialog {
    background: #141516;
}

#app_root {
    background: #141516;
}

#title_bar {
    background: rgba(24, 25, 27, 0.95);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

#title_label {
    color: #F0F2F6;
    font-weight: 600;
    letter-spacing: 0.2px;
    font-size: 15px;
}

#side_bar {
    background: rgba(20, 21, 22, 0.98);
    border-right: 1px solid rgba(255, 255, 255, 0.06);
}

#chat_user_wid {
    background: rgba(26, 27, 29, 0.95);
    border-right: 1px solid rgba(255, 255, 255, 0.06);
}

#chat_data_wid {
    background: rgba(18, 19, 20, 0.94);
}

#chat_data_list,
#funct_wid,
#send_wid,
#search_wid {
    background: transparent;
}

QPushButton {
    background: rgba(255, 255, 255, 0.08);
    border: none;
    border-radius: 14px;
    padding: 8px 12px;
}

QLineEdit, QTextEdit {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    padding: 10px 14px;
    selection-background-color: rgba(63, 81, 181, 0.6);
}

QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #3F51B5;
    background: rgba(255, 255, 255, 0.14);
}

QTextEdit {
    padding: 14px;
}

QListWidget {
    background: transparent;
    border: none;
}

QListWidget::item {
    margin: 8px 0;
}

#chat_user_item {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 16px;
}

#chat_user_item QLabel {
    color: #D6D8DB;
}

#chat_user_item #user_name_lb {
    font-weight: 600;
}

#chat_user_item:hover {
    background: rgba(255, 255, 255, 0.1);
}

#chat_user_item[selected="true"] {
    background: rgba(63, 81, 181, 0.28);
}

#chat_bubble_container[ bubbleType="incoming" ] {
    background: rgba(255, 255, 255, 0.12);
    border-radius: 16px;
}

#chat_bubble_container[ bubbleType="outgoing" ] {
    background: rgba(63, 81, 181, 0.34);
    border-radius: 16px;
}

#chat_bubble_container[ bubbleType="system" ] {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 16px;
}

#chat_bubble_sender {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.7);
}

#chat_bubble_text {
    font-size: 14px;
    color: #F3F5F7;
}

QProgressBar {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    text-align: center;
    height: 10px;
}

QProgressBar::chunk {
    background: rgba(63, 81, 181, 0.95);
    border-radius: 8px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px 2px 2px 2px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.25);
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0px;
}

QToolTip {
    background: rgba(30, 32, 35, 0.98);
    color: #F2F4F8;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 6px 8px;
}

/* Light theme overrides */
#app_root[theme="light"] {
    background: #F5F6F8;
}

#app_root[theme="light"] * {
    color: #111214;
}

#app_root[theme="light"] #title_bar {
    background: #FFFFFF;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
}

#app_root[theme="light"] #side_bar {
    background: #F2F3F6;
    border-right: 1px solid rgba(0, 0, 0, 0.08);
}

#app_root[theme="light"] #chat_user_wid {
    background: #FFFFFF;
    border-right: 1px solid rgba(0, 0, 0, 0.08);
}

#app_root[theme="light"] #chat_data_wid {
    background: #F9FAFB;
}

#app_root[theme="light"] QLineEdit,
#app_root[theme="light"] QTextEdit {
    background: #FFFFFF;
    border: 1px solid rgba(0, 0, 0, 0.12);
    color: #111214;
}

#app_root[theme="light"] QLineEdit::placeholder,
#app_root[theme="light"] QTextEdit::placeholder {
    color: rgba(17, 18, 20, 0.55);
}

#app_root[theme="light"] QLineEdit:focus,
#app_root[theme="light"] QTextEdit:focus {
    border: 1px solid #3F51B5;
    background: #FFFFFF;
}

#app_root[theme="light"] #chat_user_item {
    background: rgba(0, 0, 0, 0.05);
}

#app_root[theme="light"] #chat_user_item QLabel {
    color: #111214;
}

#app_root[theme="light"] #chat_user_item:hover {
    background: rgba(0, 0, 0, 0.1);
}

#app_root[theme="light"] #chat_user_item[selected="true"] {
    background: rgba(63, 81, 181, 0.2);
}

#app_root[theme="light"] #chat_bubble_container[ bubbleType="incoming" ] {
    background: #FFFFFF;
}

#app_root[theme="light"] #chat_bubble_container[ bubbleType="outgoing" ] {
    background: rgba(63, 81, 181, 0.22);
}

#app_root[theme="light"] #chat_bubble_container[ bubbleType="system" ] {
    background: rgba(0, 0, 0, 0.08);
}

#app_root[theme="light"] #chat_bubble_sender {
    color: rgba(17, 18, 20, 0.6);
}

#app_root[theme="light"] #chat_bubble_text {
    color: #111214;
}

#app_root[theme="light"] QProgressBar {
    background: rgba(0, 0, 0, 0.08);
}

#app_root[theme="light"] QProgressBar::chunk {
    background: rgba(63, 81, 181, 0.9);
}

#app_root[theme="light"] QToolTip {
    background: #FFFFFF;
    color: #111214;
    border: 1px solid rgba(0, 0, 0, 0.1);
}
